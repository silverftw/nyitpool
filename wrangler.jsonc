// BearBreak — Cloudflare Workers configuration
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",

  // Static assets: the pool timer SPA lives in public/.
  // Worker runs first ONLY for /api/* — every other path is served straight from assets.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // D1 database for the Table Queue.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nyitpool",
      "database_id": "ab083be2-c31b-4d59-b6b7-dd518212eb29"
    }
  ],

  // Timer remote control (T16): one SQLite-backed Durable Object per room.
  // The DO relays phone POSTs to the laptop's hibernating WebSocket — the hub/D1
  // stay completely out of the command path. new_sqlite_classes = free-tier eligible.
  "durable_objects": {
    "bindings": [
      { "name": "TABLE_ROOM", "class_name": "TableRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1-tableroom", "new_sqlite_classes": ["TableRoom"] }
  ],

  "observability": {
    "enabled": true
  }
}
